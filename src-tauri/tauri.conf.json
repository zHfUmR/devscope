{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevScope",
  "version": "0.1.0",
  "identifier": "com.devscope.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DevScope",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "publisher": "DevScope",
    "category": "DeveloperTool",
    "shortDescription": "macOS 开发者工具箱：本地环境诊断与 Flutter 项目分析",
    "longDescription": "DevScope 是一个 macOS 原生开发者工具箱，用于检测 Flutter / Android / iOS 开发环境、分析 Flutter 项目配置与构建日志，并导出本地诊断报告。所有检测都在本机完成，数据不会上传。",
    "copyright": "Copyright © 2026 DevScope",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  }
}
